{
  "name": "notification-system",
  "private": true,
  "type": "module",
  "scripts": {
    "dev:gateway": "pnpm --filter api-gateway dev",
    "dev:email": "pnpm --filter email-worker dev",
    "dev:sms": "pnpm --filter sms-worker dev",
    "dev:dashboard": "pnpm --filter dashboard dev",
    "dev": "pnpm -r dev",
    "build": "pnpm -r build",
    "test": "pnpm -r test",
    "clean": "pnpm -r exec rm -rf dist",
    "infra": "docker compose up rabbitmq mailpit -d",
    "prepare": "lefthook install",
    "biome:format": "biome format --write .",
    "biome:check": "biome check --write ."
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.15",
    "@commitlint/cli": "^21.0.1",
    "@commitlint/config-conventional": "^21.0.1",
    "lefthook": "^2.1.8"
  }
}
